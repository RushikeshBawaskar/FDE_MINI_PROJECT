# Copy to .env and fill in. main.py loads this file itself (no extra tooling needed).

# Anthropic API key used for the two LLM-batched jobs: review-band tiebreak and
# outreach-message writing. Leave empty to run in deterministic-fallback mode
# (verdicts stay as scored, outreach messages use the template) — no crash, no cost.
ANTHROPIC_API_KEY=

# Optional: override the model id set in config.yaml (llm.model).
ANTHROPIC_MODEL=
